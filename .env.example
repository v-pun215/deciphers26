# ─── Event Timing ────────────────────────────────────────────────────────────
EVENT_START_UNIX=1791331200
EVENT_END_UNIX=1793318400

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com

# ─── Session Security ─────────────────────────────────────────────────────────
# A long random secret used to salt OTP hashes and answer hashes — generate with:
#   openssl rand -hex 32
AUTH_SALT=replace_with_random_secret

# ─── SMTP (OTP Email Delivery) ────────────────────────────────────────────────
# The hostname of your SMTP server
SMTP_HOST=smtp.gmail.com

# Port:
#   465  → implicit TLS (recommended)
#   587  → STARTTLS
#   25   → plain (not recommended)
SMTP_PORT=465

# The "From" address / login username for your SMTP account
SMTP_USER=your-address@gmail.com

# The SMTP password or app-specific password
SMTP_PASS=your_smtp_password_or_app_password
